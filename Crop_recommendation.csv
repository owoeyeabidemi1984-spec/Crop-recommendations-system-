.mdui-checkbox { border: 2px solid var(--color-text-light); display: inline-flex; height: 12px; width: 12px; fill: var(--color-void); cursor: pointer; outline: none; }

.mdui-checkbox:hover { background-color: var(--color-grey-lightest); border-color: var(--color-active-darker); }

