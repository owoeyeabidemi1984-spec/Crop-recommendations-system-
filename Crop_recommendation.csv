#gh-cta-btn.gh-icon-btn:active .gh-icon, #gh-cta-btn.gh-icon-btn:focus .gh-icon, #gh-cta-btn.gh-icon-btn:hover .gh-icon, #gh-signin-btn.gh-icon-btn:active .gh-icon, #gh-signin-btn.gh-icon-btn:focus .gh-icon, #gh-signin-btn.gh-icon-btn:hover .gh-icon { fill: rgb(235, 101, 0) !important; }

